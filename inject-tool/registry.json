{
  "registry": "quay.io/che-incubator",
  "tag": "next",
  "infrastructure": {
    "patch": [
      {
        "op": "add",
        "path": "/spec/template/components/-",
        "value": { "name": "injected-tools", "volume": { "size": "1Gi" } }
      }
    ]
  },
  "tools": {
    "opencode": {
      "description": "AI coding assistant by OpenCode",
      "pattern": "init",
      "src": "/usr/local/bin/opencode",
      "binary": "opencode",
      "version": "v1.19.4",
      "injector": {
        "memoryLimit": "128Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "opencode-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/opencode:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/opencode", "/injected-tools/opencode"],
              "memoryLimit": "128Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    },
    "goose": {
      "description": "AI coding assistant by Block",
      "pattern": "init",
      "src": "/usr/local/bin/goose",
      "binary": "goose",
      "version": "v1.56.0",
      "injector": {
        "memoryLimit": "128Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "goose-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/goose:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/goose", "/injected-tools/goose"],
              "memoryLimit": "128Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    },
    "claude-code": {
      "description": "Claude Code AI assistant by Anthropic",
      "pattern": "init",
      "src": "/usr/local/bin/claude",
      "binary": "claude",
      "version": "2.1.310",
      "injector": {
        "memoryLimit": "128Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "claude-code-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/claude-code:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/claude", "/injected-tools/claude"],
              "memoryLimit": "128Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [{ "name": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "value": "1" }],
        "memoryLimit": "1024Mi",
        "postStart": ""
      }
    },
    "kilocode": {
      "description": "Kilo Code AI assistant (VS Code extension with AI backend)",
      "pattern": "bundle",
      "src": "/opt/kilocode",
      "binary": "kilo",
      "version": "7.8.18",
      "injector": {
        "memoryLimit": "256Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "kilocode-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/kilocode:next",
              "command": ["/bin/sh"],
              "args": ["-c", "cp -a /opt/kilocode/. /injected-tools/kilocode/"],
              "memoryLimit": "256Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    },
    "gemini-cli": {
      "description": "Gemini CLI AI assistant by Google",
      "pattern": "bundle",
      "src": "/opt/gemini-cli",
      "binary": "gemini",
      "version": "0.65.0",
      "injector": {
        "memoryLimit": "256Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "gemini-cli-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/gemini-cli:next",
              "command": ["/bin/sh"],
              "args": ["-c", "cp -a /opt/gemini-cli/. /injected-tools/gemini-cli/"],
              "memoryLimit": "256Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [{ "name": "GEMINI_CLI_HOME", "value": "/tmp/gemini-home" }],
        "postStart": "mkdir -p /tmp/gemini-home/.gemini && echo '{\"projects\":{}}' > /tmp/gemini-home/.gemini/projects.json"
      }
    },
    "cursor-cli": {
      "description": "Cursor Agent CLI",
      "pattern": "bundle",
      "src": "/opt/cursor-cli",
      "binary": "agent",
      "version": "2026.10.22-27dcf5f",
      "injector": {
        "memoryLimit": "512Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "cursor-cli-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/cursor-cli:next",
              "command": ["/bin/sh"],
              "args": ["-c", "cp -a /opt/cursor-cli/. /injected-tools/cursor-cli/"],
              "memoryLimit": "512Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/cursor-compile-cache\"; ln -sf /injected-tools/cursor-cli/bin/cursor-agent /injected-tools/bin/cursor-agent"
      }
    },
    "tmux": {
      "description": "Terminal multiplexer",
      "pattern": "init",
      "src": "/usr/local/bin/tmux",
      "binary": "tmux",
      "version": "3.7c",
      "versionCommand": ["tmux", "-V"],
      "injector": {
        "memoryLimit": "128Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "tmux-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/tmux:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/tmux", "/injected-tools/tmux"],
              "memoryLimit": "128Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    },
    "gh": {
      "description": "GitHub CLI",
      "pattern": "init",
      "src": "/usr/local/bin/gh",
      "binary": "gh",
      "version": "2.103.2",
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "gh-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/gh:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/gh", "/injected-tools/gh"],
              "memoryLimit": "128Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    },
    "python3": {
      "description": "Python3 interpreter",
      "pattern": "bundle",
      "src": "/opt/python3",
      "binary": "python3",
      "version": "3.13.18",
      "injector": {
        "memoryLimit": "256Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "python3-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/python3:next",
              "command": ["/bin/sh"],
              "args": ["-c", "cp -a /opt/python3/. /injected-tools/python3/"],
              "memoryLimit": "256Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": "mkdir -p /injected-tools/bin && ln -sf /injected-tools/python3/bin/python3.13 /injected-tools/bin/python3.13 && ln -sf /injected-tools/python3/bin/pip /injected-tools/bin/pip && ln -sf /injected-tools/python3/bin/pip3 /injected-tools/bin/pip3",
        "memoryBump": "0Mi"
      }
    },
    "codex": {
      "description": "OpenAI's Codex CLI coding agent",
      "pattern": "init",
      "src": "/usr/local/bin/codex",
      "binary": "codex",
      "version": "0.164.0",
      "injector": {
        "memoryLimit": "256Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "codex-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/codex:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/codex", "/injected-tools/codex"],
              "memoryLimit": "256Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    },
    "uv": {
      "description": "Python package and project manager",
      "pattern": "init",
      "src": "/usr/local/bin/uv",
      "binary": "uv",
      "version": "0.13.6",
      "injector": {
        "memoryLimit": "128Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "uv-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/uv:next",
              "command": ["/bin/cp"],
              "args": ["/usr/local/bin/uv", "/usr/local/bin/uvx", "/injected-tools/"],
              "memoryLimit": "128Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [
          { "name": "UV_PYTHON_INSTALL_DIR", "value": "/injected-tools/uv-state/python" },
          { "name": "UV_TOOL_DIR", "value": "/injected-tools/uv-state/tools" },
          { "name": "UV_TOOL_BIN_DIR", "value": "/injected-tools/bin" }
        ],
        "postStart": "mkdir -p /injected-tools/bin && ln -sf /injected-tools/uvx /injected-tools/bin/uvx"
      }
    },
    "pi": {
      "description": "Pi coding agent by earendil-works",
      "pattern": "bundle",
      "src": "/opt/pi",
      "binary": "pi",
      "version": "1.4.0",
      "injector": {
        "memoryLimit": "256Mi"
      },
      "patch": [
        {
          "op": "add",
          "path": "/spec/template/components/-",
          "value": {
            "name": "pi-injector",
            "container": {
              "image": "quay.io/che-incubator/tools-injector/pi:next",
              "command": ["/bin/sh"],
              "args": ["-c", "cp -a /opt/pi/. /injected-tools/pi/"],
              "memoryLimit": "256Mi",
              "mountSources": false,
              "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }]
            }
          }
        }
      ],
      "editor": {
        "volumeMounts": [{ "name": "injected-tools", "path": "/injected-tools" }],
        "env": [],
        "postStart": ""
      }
    }
  }
}
